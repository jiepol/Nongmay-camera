<?xml version="1.0" encoding="utf-8"?>
<!--
  NongMay Camera v1.1 (standalone rebuild).
  Namespace/R package: com.nongmay.camera (Gradle: `namespace`; tools/build_apk.sh injects it for
  aapt2). The installed application id is
  com.nongmay.camera.v11 so it installs NEXT TO v1.0 (app.nongmay.camera) instead of
  pretending to be a signed upgrade of it.
  No INTERNET permission on purpose: photos, video and voice can never leave the phone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Requested only when the user turns on Voice Shutter or video sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:name="com.nongmay.camera.App"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NongMay">

        <activity
            android:name="com.nongmay.camera.ui.CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.nongmay.camera.voice.VoiceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.nongmay.camera.storymax.StoryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/storymax_label"
            android:screenOrientation="portrait">
            <!-- Own launcher entry + "Share to StoryMax" from Samsung Gallery: Import-to-Story works even
                 when the camera engine is unavailable. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.nongmay.camera.storymax.quality.LabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.nongmay.camera.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.nongmay.camera.perf.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
